{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npx --yes pnpm@11.25.0 install --frozen-lockfile",
  "buildCommand": "npm run build:static",
  "outputDirectory": "dist-static",
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/:lang(cs|de|es|fr|id|hu|nl|pt|tr|ru|uk|hi|ja|ar|zh)",
      "destination": "/:lang/",
      "permanent": true
    },
    {
      "source": "/en",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/settings/:part(avatar|email|sound|chat|reminders|farm-app|language|privacy)",
      "destination": "/?open=settings&part=:part",
      "permanent": false
    },
    {
      "source": "/settings/:part(avatar|email|sound|chat|reminders|farm-app|language|privacy)/",
      "destination": "/?open=settings&part=:part",
      "permanent": false
    },
    {
      "source": "/settings",
      "destination": "/?open=settings",
      "permanent": false
    },
    {
      "source": "/settings/",
      "destination": "/?open=settings",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/partners",
      "destination": "/partners.html"
    },
    {
      "source": "/partners/",
      "destination": "/partners.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/privacy/",
      "destination": "/privacy.html"
    },
    {
      "source": "/delete-account",
      "destination": "/delete-account.html"
    },
    {
      "source": "/delete-account/",
      "destination": "/delete-account.html"
    },
    {
      "source": "/support",
      "destination": "/support.html"
    },
    {
      "source": "/support/",
      "destination": "/support.html"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/app/",
      "destination": "/app.html"
    },
    {
      "source": "/wiki",
      "destination": "/wiki/index.html"
    },
    {
      "source": "/wiki/",
      "destination": "/wiki/index.html"
    },
    {
      "source": "/wiki/:topic([a-z-]+)",
      "destination": "/wiki/:topic.html"
    },
    {
      "source": "/:lang(cs|de|es|fr|id|hu|nl|pt|tr|ru|uk|hi|ja|ar|zh)/",
      "destination": "/:lang/index.html"
    },
    {
      "source": "/:lang(cs|de|es|fr|id|hu|nl|pt|tr|ru|uk|hi|ja|ar|zh)/support",
      "destination": "/:lang/support.html"
    },
    {
      "source": "/:lang(cs|de|es|fr|id|hu|nl|pt|tr|ru|uk|hi|ja|ar|zh)/support/",
      "destination": "/:lang/support.html"
    },
    {
      "source": "/:lang(cs|de|es|fr|id|hu|nl|pt|tr|ru|uk|hi|ja|ar|zh)/app",
      "destination": "/:lang/app.html"
    },
    {
      "source": "/:lang(cs|de|es|fr|id|hu|nl|pt|tr|ru|uk|hi|ja|ar|zh)/app/",
      "destination": "/:lang/app.html"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/:lang(cs|de|es|fr|id|hu|nl|pt|tr|ru|uk|hi|ja|ar|zh)/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/crazygames.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors https://*.crazygames.com https://crazygames.com https://*.crazygames.fr https://*.crazygames.co.id https://*.crazygames.cz https://*.crazygames.dk https://*.crazygames.hu https://*.crazygames.nl https://*.crazygames.no https://*.crazygames.pl https://*.crazygames.com.br https://*.crazygames.ro https://*.crazygames.fi https://*.crazygames.se https://*.crazygames.ru https://*.crazygames.com.ua https://*.crazygames.at https://*.crazygames.jp https://*.crazygames.pt https://*.crazygames.vn https://*.crazygames.com.vn https://*.crazygames.co.kr https://*.1001juegos.com capacitor://app.crazygames.com http://localhost:* http://127.0.0.1:*"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/cloud/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
